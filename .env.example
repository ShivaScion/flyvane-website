# ==============================================================================
# CRYSTALSTEED PRODUCTION BACKEND CONFIGURATION (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Supabase PostgreSQL)
# ------------------------------------------------------------------------------
# Required for persisting advisory leads to the `advisory_leads` table.
# If omitted, leads fallback to local JSON persistence (`supabase/advisory_leads_store.json`).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Client-side Supabase keys (if client direct query is needed)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------------------------------------------------
# 2. TRANSACTIONAL EMAIL NOTIFICATIONS (Resend)
# ------------------------------------------------------------------------------
# API key from https://resend.com
RESEND_API_KEY=re_123456789abcdef

# Sender identity (must be a verified domain in Resend)
RESEND_FROM_EMAIL="CrystalSteed Advisory <advisory@crystalsteed.in>"

# Admin notification inbox (where partner brief alerts are routed)
ADMIN_NOTIFICATION_EMAIL=anshrudra@crystalsteed.in

# ------------------------------------------------------------------------------
# 3. INSTANT MOBILE ALERTS (Twilio WhatsApp)
# ------------------------------------------------------------------------------
# Credentials from https://console.twilio.com
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Twilio WhatsApp sender (e.g., whatsapp:+14155238886 for Twilio Sandbox)
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Destination phone number (e.g., whatsapp:+1234567890)
MY_PERSONAL_WHATSAPP=whatsapp:+1234567890
